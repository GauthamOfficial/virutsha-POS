# --- Server ---
PORT=8000
NODE_ENV=development

# --- Database ---
# Local MongoDB installed on the laptop (works with no internet):
MONGODB_URI=mongodb://127.0.0.1:27017/virutsha-pos
# Or MongoDB Atlas (cloud, needed for Vercel):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/virutsha-pos

# --- Security ---
# Any long random string. Change this before going live.
JWT_SECRET=change-this-to-a-long-random-string

# --- Frontend origins allowed to call this API (comma separated) ---
CLIENT_URL=http://localhost:5173

# --- First admin account created by `npm run seed` ---
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@virutsha.lk
SEED_ADMIN_PHONE=0770000000
SEED_ADMIN_PASSWORD=admin123
